# Copy to .env and fill in for local development.

# --- Database (local Postgres, no Docker) ---
DATABASE_URL=postgresql+asyncpg://hfmg:hfmg_dev_local@localhost:5432/hfmg_helpdesk

# --- CORS (Vite dev server) ---
CORS_ORIGINS=http://localhost:5173

# --- Email notifications (Twilio SendGrid, via its API -- not SMTP) ---
# Without SENDGRID_API_KEY set, sends are skipped (logged, no content) rather
# than dumping ticket details to the log -- the app still runs end-to-end.
ENABLE_EMAIL_NOTIFICATIONS=true
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
# Every notification is sent from EMAIL_FROM to HELPDESK_EMAIL -- fixed, not
# configurable per ticket.
EMAIL_FROM=reminder@hfmg.net
HELPDESK_EMAIL=helpdesk@hfmg.net

# --- LLM provider ---
# Powers AI ticket summaries and the voice agent's understanding of callers.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
# Optional: point at a compatible gateway/proxy instead of api.openai.com.
OPENAI_BASE_URL=
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=2000
# Both are omitted from requests unless set here. Reasoning models (the gpt-5
# family) REJECT `temperature` -- leave it blank for those. Set it only for a
# model that supports it.
OPENAI_TEMPERATURE=
# Optional, for reasoning models: minimal | low | medium | high.
# "minimal" gives the fastest response, which matters on voice calls.
OPENAI_REASONING_EFFORT=

# --- AI summary (optional, off by default) ---
ENABLE_AI_SUMMARY=false

# --- Twilio voice agent (Phase 2) ---
# Auth token from the Twilio console; used to verify webhook signatures.
TWILIO_AUTH_TOKEN=
# Keep true in any deployed environment. Only set false for local testing
# without Twilio -- it disables webhook authentication entirely.
TWILIO_VALIDATE_SIGNATURE=true
# Public URL Twilio calls (e.g. your ngrok https URL). Needed for signature
# validation when running behind a tunnel or proxy.
TWILIO_PUBLIC_BASE_URL=
VOICE_TTS_VOICE=Polly.Joanna-Neural
VOICE_LANGUAGE=en-US
VOICE_SPEECH_MODEL=experimental_conversations
# The voice agent needs OPENAI_API_KEY set to understand callers, and reuses
# the same provider/model as the AI summary feature above.

# --- SIP gateway (Nextiva extension, via a SIPSorcery service elsewhere) ---
# Shared secret the gateway presents as `Authorization: Bearer <token>`.
VOICE_SIP_GATEWAY_TOKEN=
